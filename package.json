{
  "name": "tiny-ja-date",
  "version": "1.4.0",
  "description": "Tiny TypeScript date utilities for Japanese UI.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:demo": "tsc --declaration false --outDir docs",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "test": "vitest",
    "prepublishOnly": "npm test -- --run && npm run build"
  },
  "keywords": [
    "japanese",
    "date",
    "datetime",
    "format",
    "relative-date",
    "time-zone",
    "business-day",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.0.0",
    "vitest": "^4.1.6"
  }
}
